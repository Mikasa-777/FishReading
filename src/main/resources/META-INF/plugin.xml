<!-- Plugin Configuration File: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN, cannot be changed between the plugin versions. -->
    <id>com.github.mikasastacy.fishreading</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>FishReading</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://github.com/mikasastacy">Mikasa Stacy</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        <h3>Fish Reading - 看书大师</h3>
        <p>一款专为 IntelliJ IDEA 打造的电子书阅读器。</p>
        <br>
        <b>当前主要功能：</b>
        <ul>
            <li>支持导入标准 .epub 与 .txt 格式电子书</li>
            <li>快捷键逐行切行，极致隐蔽</li>
            <li>支持章节选择与快速跳转</li>
        </ul>
        <p><i>祝您阅读愉快！</i></p>
    ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.MyMessageBundle</resource-bundle>

    <actions>
        <action id="com.github.mikasastacy.fishreading.NextLineAction"
                class="com.github.mikasastacy.fishreading.actions.NextLineAction">
            <keyboard-shortcut keymap="$default" first-keystroke="alt L"/>
        </action>

        <action id="com.github.mikasastacy.fishreading.PrevLineAction"
                class="com.github.mikasastacy.fishreading.actions.PrevLineAction">
            <keyboard-shortcut keymap="$default" first-keystroke="alt K"/>
        </action>

        <action id="com.github.mikasastacy.fishreading.SelectChapterAction"
                class="com.github.mikasastacy.fishreading.actions.SelectChapterAction">
            <keyboard-shortcut keymap="$default" first-keystroke="alt DOWN"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="control alt DOWN"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="control alt DOWN"/>
        </action>

        <group id="com.github.mikasastacy.fishreading.MainMenu" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>

            <action id="com.github.mikasastacy.fishreading.LoadEpubAction"
                    class="com.github.mikasastacy.fishreading.actions.LoadBookAction"/>
            <group id="com.github.mikasastacy.fishreading.ReadingLineCountMenu"
                   class="com.github.mikasastacy.fishreading.actions.ReadingLineCountMenuGroup"/>
            <separator/>

            <group id="com.github.mikasastacy.fishreading.BookAndChapterMenu"
                   class="com.github.mikasastacy.fishreading.actions.BookAndChapterMenuGroup"/>
        </group>
    </actions>

</idea-plugin>
